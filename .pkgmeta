package-as: EditModeAnchors
enable-toc-creation: yes
enable-nolib-creation: no

ignore:
  - .github
  - .gitignore
  - .gitmodules
  - .pkgmeta
  - AGENTS.md
  - CLAUDE.md
  - CONTRIBUTING.md
  - LICENSE
  - README.md
  - RELEASE_NOTES.md

externals:
  Libs/LibEditMode:
    url: https://github.com/p3lim-wow/LibEditMode.git
    tag: 18

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
